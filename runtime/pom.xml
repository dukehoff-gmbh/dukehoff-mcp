    <properties>
        <!-- application name: bin/dukehoffmcp, etc/dukehoffmcp.conf, the dukehoffmcp cluster with our module -->
        <brandingToken>dukehoffmcp</brandingToken>
        <!-- the nb-javac release NetBeans bundles (java/modules/ext/nb-javac-<file version>.jar): its
             source ships in sources/ (GPL-2.0 with Classpath Exception); the build fails if the
             bundled jar is not byte-identical to this release on Maven Central -->
        <nbjavac.version>jdk-27+26</nbjavac.version>
        <nbjavac.file.version>jdk-27-26</nbjavac.file.version>
    </properties>


                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-hudson-ant</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-hudson-maven</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-java-graph</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-java-module-graph</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-maven-graph</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-maven-checkstyle</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-maven-coverage</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-gradle-java-coverage</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-projectimport-eclipse-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-projectimport-eclipse-j2se</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-editor-htmlui</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-languages-antlr</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-java-disco</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-java-kit</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-maven-kit</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>org-netbeans-modules-gradle-kit</artifactId>
                </exclusion>
                <exclusion>

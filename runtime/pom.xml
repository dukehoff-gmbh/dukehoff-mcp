    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <configuration>
                    <brandingToken>${brandingToken}</brandingToken>
                    <etcConfFile>src/main/nbm/dukehoffmcp.conf</etcConfFile>
                </configuration>
            </plugin>
            <plugin>
                <!-- nb-javac from Maven Central: the jar (to compare with the bundled one) and its source -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>nb-javac-source</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/nb-javac</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.dukescript.nbjavac</groupId>
                                    <artifactId>nb-javac</artifactId>
                                    <version>${nbjavac.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.dukescript.nbjavac</groupId>
                                    <artifactId>nb-javac</artifactId>
                                    <version>${nbjavac.version}</version>
                                    <classifier>sources</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.dukescript.nbjavac</groupId>
                                    <artifactId>nb-javac</artifactId>
                                    <version>${nbjavac.version}</version>
                                    <classifier>api</classifier>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- the dukehoff-mcp launcher next to bin/dukehoffmcp (antrun keeps it executable), the license files,
                     VERSION and the archives target/dukehoff-mcp-<version>.tar.gz and .zip -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>launcher</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy file="${project.basedir}/../launcher/dukehoff-mcp" todir="${project.build.directory}/${brandingToken}/bin"/>
                                <chmod file="${project.build.directory}/${brandingToken}/bin/dukehoff-mcp" perm="755"/>
                                <!-- the Java launcher for Windows (and any platform): java -jar bin/dukehoff-mcp.jar -->
                                <copy file="${project.basedir}/../launcher/target/dukehoff-mcp.jar" todir="${project.build.directory}/${brandingToken}/bin"/>
                                <copy file="${project.basedir}/../launcher/dukehoff-mcp.cmd" todir="${project.build.directory}/${brandingToken}/bin"/>
                                <!-- license texts and notices of everything bundled (license-inventory.py) -->
                                <copy todir="${project.build.directory}/${brandingToken}">
                                    <fileset dir="${project.basedir}/src/main/licenses" excludes="inventory.tsv"/>
                                </copy>
                                <!-- nb-javac's source (THIRD-PARTY-SOURCES), only for the jar we really ship -->
                                <fail message="java/modules/ext/nb-javac-${nbjavac.file.version}.jar is not nb-javac ${nbjavac.version} from Maven Central: update nbjavac.version and nbjavac.file.version in runtime/pom.xml and THIRD-PARTY-SOURCES">
                                    <condition>
                                        <not>
                                            <and>
                                                <filesmatch file1="${project.build.directory}/${brandingToken}/java/modules/ext/nb-javac-${nbjavac.file.version}.jar"
                                                            file2="${project.build.directory}/nb-javac/nb-javac-${nbjavac.version}.jar"/>
                                                <filesmatch file1="${project.build.directory}/${brandingToken}/java/modules/ext/nb-javac-${nbjavac.file.version}-api.jar"
                                                            file2="${project.build.directory}/nb-javac/nb-javac-${nbjavac.version}-api.jar"/>
                                            </and>
                                        </not>
                                    </condition>
                                </fail>
                                <copy file="${project.build.directory}/nb-javac/nb-javac-${nbjavac.version}-sources.jar"
                                      todir="${project.build.directory}/${brandingToken}/sources"/>
                                <echo file="${project.build.directory}/${brandingToken}/VERSION">dukehoff-mcp ${project.version} (NetBeans ${netbeans.version}, built ${maven.build.timestamp})${line.separator}</echo>
                                <!-- the distributable archive; system tar keeps the executable bits of the scripts -->
                                <exec executable="tar" dir="${project.build.directory}" failonerror="true">
                                    <arg line="czf dukehoff-mcp-${project.version}.tar.gz ${brandingToken}"/>
                                </exec>
                                <!-- the same as zip for Windows. nbm-maven-plugin made its own zip (the build
                                     artifact) before the steps above, without launchers and licenses:
                                     replace it with the complete one and copy that under the distribution name -->
                                <zip destfile="${project.build.directory}/${project.artifactId}-${project.version}.zip">
                                    <!-- zip keeps no permissions by itself: mark the scripts executable for unzip -->
                                    <zipfileset dir="${project.build.directory}" filemode="755"
                                                includes="${brandingToken}/bin/dukehoff-mcp ${brandingToken}/bin/dukehoffmcp ${brandingToken}/platform/lib/nbexec ${brandingToken}/extide/ant/bin/** ${brandingToken}/java/maven/bin/**"/>
                                    <zipfileset dir="${project.build.directory}" includes="${brandingToken}/**"
                                                excludes="${brandingToken}/bin/dukehoff-mcp ${brandingToken}/bin/dukehoffmcp ${brandingToken}/platform/lib/nbexec ${brandingToken}/extide/ant/bin/** ${brandingToken}/java/maven/bin/**"/>
                                </zip>
                                <copy file="${project.build.directory}/${project.artifactId}-${project.version}.zip"
                                      tofile="${project.build.directory}/dukehoff-mcp-${project.version}.zip"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

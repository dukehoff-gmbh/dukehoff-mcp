{
  "name": "dukehoff-mcp-java",
  "displayName": "Dukehoff MCP for Java",
  "description": "Java code intelligence and refactoring for GitHub Copilot and other agents in VS Code, over MCP: find usages and implementations, compile errors without a build, rename, change signature, move, safe delete and more, from the Apache NetBeans Java support.",
  "version": "0.1.0",
  "publisher": "dukehoff",
  "license": "Apache-2.0",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dukehoff-gmbh/dukehoff-mcp"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "keywords": [
    "java",
    "mcp",
    "copilot",
    "refactoring",
    "netbeans"
  ],
  "extensionDependencies": [
    "asf.apache-netbeans-java"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "dukehoff-mcp",
        "label": "Dukehoff MCP for Java"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "node -e \"require('fs').mkdirSync('target',{recursive:true})\" && vsce package --out target/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.101.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.6.0"
  }
}

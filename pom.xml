<!-- url and scm as they are in the modules too (Maven would append the module's name) -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.dukehoff.mcp</groupId>
    <artifactId>dukehoff-mcp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>dukehoff-mcp</name>
    <description>Java code intelligence and refactoring for coding agents, served over MCP by a headless NetBeans.</description>
    <url>https://github.com/dukehoff-gmbh/dukehoff-mcp</url>
    <organization>
        <name>Dukehoff GmbH</name>
        <url>https://dukehoff.com</url>
    </organization>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Anton Epple</name>
            <organization>Dukehoff GmbH</organization>
            <organizationUrl>https://dukehoff.com</organizationUrl>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/dukehoff-gmbh/dukehoff-mcp.git</connection>
        <developerConnection>scm:git:git@github.com:dukehoff-gmbh/dukehoff-mcp.git</developerConnection>
        <url>https://github.com/dukehoff-gmbh/dukehoff-mcp</url>
    </scm>
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/dukehoff-gmbh/dukehoff-mcp/issues</url>
    </issueManagement>

    <modules>
        <module>server</module>
        <!-- before runtime, which copies its jar into bin/ -->
        <module>launcher</module>
        <module>runtime</module>
        <!-- after launcher and runtime, whose output it packages -->
        <module>vscode</module>
    </modules>

    <properties>
        <!-- the NetBeans release the module is compiled against and the runtime is built from -->
        <netbeans.version>RELEASE310</netbeans.version>
        <!-- the plugin Lombok for nb-javac, in the runtime and the VS Code extension -->
        <lombok-nb-javac.version>1.0.0</lombok-nb-javac.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.netbeans.utilities</groupId>
                    <artifactId>nbm-maven-plugin</artifactId>
                    <version>14.5</version>
                    <extensions>true</extensions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <!-- NetBeans annotation processors (@Messages, @Arg, @ServiceProvider) run from the classpath -->
                        <proc>full</proc>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Xlint:-serial</arg>
                            <arg>-Xlint:-processing</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                    <configuration>
                        <!-- the module manifest written by nbm-maven-plugin -->
                        <archive>
                            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.8.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- license headers of the whole repository, from the root only: mvn validate checks them,
                 mvn -N license:format adds them to new files -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.1.2</version>
                <inherited>false</inherited>
                <configuration>
                    <strictCheck>true</strictCheck>
                    <!-- from the root over the module folders too, and with our own exclude list: the
                         plugin's default excludes skip Markdown, which carries headers here -->
                    <aggregate>true</aggregate>
                    <useDefaultExcludes>false</useDefaultExcludes>
                    <properties>
                        <license.owner>Dukehoff GmbH</license.owner>
                        <license.year>2026</license.year>
                    </properties>
                    <licenseSets>
                        <licenseSet>
                            <header>src/license/header.txt</header>
                            <excludes>
                                <exclude>LICENSE</exclude>
                                <exclude>NOTICE</exclude>
                                <exclude>src/license/**</exclude>
                                <exclude>**/.git/**</exclude>
                                <exclude>**/.gitignore</exclude>
                                <exclude>**/.gitattributes</exclude>
                                <exclude>**/.DS_Store</exclude>
                                <exclude>.claude/**</exclude>
                                <exclude>**/target/**</exclude>
                                <!-- the VS Code extension: npm packages, compiled and collected files -->
                                <exclude>**/node_modules/**</exclude>
                                <exclude>vscode/out/**</exclude>
                                <exclude>vscode/bin/**</exclude>
                                <exclude>vscode/nbcode/**</exclude>
                                <exclude>vscode/LICENSE</exclude>
                                <exclude>vscode/NOTICE</exclude>
                                <exclude>**/.vscodeignore</exclude>
                                <exclude>**/*.png</exclude>
                                <exclude>**/*.svg</exclude>
                                <!-- images, video and fonts of the README and the product page (site/) -->
                                <exclude>**/*.gif</exclude>
                                <exclude>**/*.jpg</exclude>
                                <exclude>**/*.webm</exclude>
                                <exclude>**/*.mp4</exclude>
                                <exclude>**/*.woff2</exclude>
                                <!-- the fonts' SIL Open Font License texts, shipped with them unchanged -->
                                <exclude>site/assets/fonts/LICENSE-*</exclude>
                                <!-- internal working notes, not part of the published repository -->
                                <exclude>CLAUDE.md</exclude>
                                <!-- third-party license texts and the generated inventory -->
                                <exclude>runtime/src/main/licenses/**</exclude>
                                <exclude>runtime/src/main/license-texts/**</exclude>
                                <!-- formats without comments, data and expected answers -->
                                <exclude>**/*.json</exclude>
                                <exclude>**/*.csv</exclude>
                                <exclude>**/*.tsv</exclude>
                                <exclude>**/*.patch</exclude>
                                <exclude>**/*.mf</exclude>
                                <exclude>**/expected*.txt</exclude>
                                <!-- YAML frontmatter must come first -->
                                <exclude>**/SKILL.md</exclude>
                                <!-- the sample projects agents work on in the evaluation -->
                                <exclude>eval/debug-tasks/billing/**</exclude>
                                <exclude>eval/debug-tasks/platform/src/**</exclude>
                                <exclude>eval/debug-tasks/platform/pom.xml</exclude>
                                <exclude>eval/debug-tasks/platform/data/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                        <!-- not the default ///: triple-slash lines are compiler directives in TypeScript -->
                        <ts>SLASHSTAR_STYLE</ts>
                        <md>XML_STYLE</md>
                        <conf>SCRIPT_STYLE</conf>
                        <cmd>BATCH</cmd>
                        <dukehoff-mcp>SCRIPT_STYLE</dukehoff-mcp>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>license-headers</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Maven Central (the NetBeans Plugin Portal takes plugins only from there): sources, Javadoc and
             GPG signatures, uploaded through the Central Portal. The release workflow runs
             mvn -P central -pl server -am deploy, so only this parent and the NetBeans plugin go there.
             -Dcentral.skipUpload=true builds the bundle (target/central-publishing) without uploading;
             -Dcentral.autoPublish=true publishes without the manual step in the portal. -->
        <profile>
            <id>central</id>
            <properties>
                <central.skipUpload>false</central.skipUpload>
                <central.autoPublish>false</central.autoPublish>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!-- the passphrase from MAVEN_GPG_PASSPHRASE, no pinentry (CI) -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <!-- 0.12.0 or newer: before, with Maven 3.10 (GitHub's runners) the bundle kept
                             maven-metadata-local.xml next to the version folders and Central rejected it
                             ("Bundle has content that does NOT have a .pom file") -->
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <skipUpload>${central.skipUpload}</skipUpload>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
